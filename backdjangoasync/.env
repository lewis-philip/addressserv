#--------------------------------------------------------------------------------
# Development environment variables
#--------------------------------------------------------------------------------

DEBUG=True

ALLOWED_HOSTS=

# Static file
STATICFILES_DIRS=static
STATIC_URL=static/
STATIC_ROOT=_static_collected

# Media file
MEDIA_ROOT=media
MEDIA_URL=media/

# PostgreSQL database
DB_ENGINE=django.db.backends.postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=####
DB_USER=####
DB_PASS=####

# Caching
CH_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
CH_LOCATION=127.0.0.1:11211
CH_TIMEOUT=None
CH_MAX_ENTRIES=10000
CH_CULL_FREQUENCY=3
CH_KEY_PREFIX=addressservdev
CH_VERSION=1

# Email - file based backend
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=_email_sent

